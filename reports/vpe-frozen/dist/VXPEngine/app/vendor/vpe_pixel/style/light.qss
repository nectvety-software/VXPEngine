/* VXP Pixel Editor — Light Enterprise QSS
   Tokens: @bg @surface @surface2 @surface3 @border @border_soft @text @muted @faint
           @accent @accent_hover @accent_down @accent2 @ok @warn @danger
           @canvas_bg @canvas_border @grid @shadow @glow
           @tool_idle @tool_hover @tool_active @status @menu @input @check_a @check_b */

/* Font family is set in code (QApplication.setFont). */
* {
    font-size: 13px;
    outline: none;
}

QMainWindow, QDialog {
    background: @bg;
    color: @text;
}

QWidget {
    background: transparent;
    color: @text;
}

/* ---------- Menu bar ---------- */
QMenuBar {
    background: @menu;
    background-color: @menu;
    color: @text;
    border: none;
    border-bottom: 1px solid @border;
    padding: 2px 8px;
}
QMenuBar::item {
    background: transparent;
    background-color: transparent;
    color: @text;
    padding: 6px 12px;
    border-radius: 6px;
}
QMenuBar::item:selected {
    background: @tool_hover;
    color: @text;
}
QMenu {
    background: @surface;
    border: 1px solid @border;
    border-radius: 10px;
    padding: 6px;
    color: @text;
}
QMenu::item {
    padding: 8px 28px 8px 16px;
    border-radius: 6px;
}
QMenu::item:selected {
    background: @accent;
    color: #FFFFFF;
}
QMenu::separator {
    height: 1px;
    background: @border_soft;
    margin: 6px 10px;
}

/* ---------- Toolbar / tool rail ---------- */
QToolBar {
    background: @surface;
    border: none;
    spacing: 6px;
    padding: 8px;
}
QToolButton {
    background: @tool_idle;
    color: @text;
    border: 1px solid @border;
    border-radius: 10px;
    padding: 10px;
    min-width: 36px;
    min-height: 36px;
}
QToolButton:hover {
    background: @tool_hover;
    border-color: @accent;
}
QToolButton:checked {
    background: @tool_active;
    border-color: @accent;
    color: @accent;
}

/* ---------- Buttons ---------- */
QPushButton {
    background: @surface;
    color: @text;
    border: 1px solid @border;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 500;
}
QPushButton:hover {
    background: @tool_hover;
    border-color: @accent;
}
QPushButton#Primary {
    background: @accent;
    border-color: @accent;
    color: #FFFFFF;
}
QPushButton#Primary:hover {
    background: @accent_hover;
}
QPushButton#Danger {
    background: transparent;
    border-color: @danger;
    color: @danger;
}
QPushButton#Ghost {
    background: transparent;
    border-color: transparent;
    color: @muted;
}

/* ---------- Panels ---------- */
QFrame#Panel, QFrame#Card {
    background: @surface;
    border: 1px solid @border;
    border-radius: 12px;
}
QFrame#SidePanel {
    background: @surface;
    border: none;
    border-left: 1px solid @border;
}
QFrame#ToolRail {
    background: @surface;
    border: none;
    border-right: 1px solid @border;
}
QFrame#StatusBar {
    background: @status;
    border-top: 1px solid @border;
}

QLabel#Heading {
    color: @muted;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 0;
}
QLabel#Title {
    color: @text;
    font-size: 18px;
    font-weight: 600;
}
QLabel#Muted { color: @muted; font-size: 12px; }
QLabel#Value { color: @text; font-size: 12px; font-weight: 600; }
QLabel#Accent { color: @accent; font-weight: 600; }

/* ---------- Inputs ---------- */
QLineEdit, QSpinBox, QComboBox {
    background: @input;
    color: @text;
    border: 1px solid @border;
    border-radius: 8px;
    padding: 6px 10px;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: @accent;
}
QComboBox QAbstractItemView {
    background: @surface;
    border: 1px solid @border;
    selection-background-color: @accent;
    selection-color: #FFFFFF;
}

/* ---------- Scroll ---------- */
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical {
    background: @surface3;
    border-radius: 5px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover { background: @accent; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; }
QScrollBar::handle:horizontal {
    background: @surface3;
    border-radius: 5px;
    min-width: 28px;
}

/* ---------- Status ---------- */
QStatusBar {
    background: @status;
    color: @muted;
    border-top: 1px solid @border;
    font-size: 12px;
}
QStatusBar QLabel {
    color: @muted;
    background: transparent;
    padding: 0 10px;
}
QStatusBar QLabel#Hi { color: @text; }

QFrame#CanvasHost {
    background: @canvas_bg;
    border: none;
}

/* ---------- Asset gallery ---------- */
QFrame#AssetCard {
    background: @surface;
    border: 1px solid @border;
    border-radius: 12px;
}
QFrame#AssetCard:hover {
    border-color: @accent;
    background: @surface2;
}
QLabel#AssetThumb {
    background: @canvas_bg;
    border: 1px solid @border_soft;
    border-radius: 8px;
}
QLabel#AssetName {
    color: @text;
    font-weight: 600;
}
QLabel#AssetKind {
    color: @accent;
    font-weight: 700;
    letter-spacing: 1px;
}
