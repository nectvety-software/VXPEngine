build vxpe_pixel_font_regression: phony vxpe_pixel_font_regression.exe

build vxpe_scatter_regression: phony vxpe_scatter_regression.exe

build vxpe_scene25d_regression: phony vxpe_scene25d_regression.exe

build vxpe_sprite_fast_regression: phony vxpe_sprite_fast_regression.exe

build vxpe_stage2d_regression: phony vxpe_stage2d_regression.exe

build vxpe_story2d_c_api: phony vxpe_story2d_c_api.exe

build vxpe_story2d_regression: phony vxpe_story2d_regression.exe

build vxpe_toon3d_c_api: phony vxpe_toon3d_c_api.exe

build vxpe_toon3d_regression: phony vxpe_toon3d_regression.exe

build vxpgdx_strategy_rpg_regression: phony vxpgdx_strategy_rpg_regression.exe

build vxpgdx_test_runtime: phony libvxpgdx_test_runtime.a

build vxpgdx_ui_arm_regression: phony vxpgdx_ui_arm_regression.exe

build vxpgdx_vxtm3_regression: phony vxpgdx_vxtm3_regression.exe

