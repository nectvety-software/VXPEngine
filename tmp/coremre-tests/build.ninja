  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\MRE\VXPEngine\tmp\coremre-tests && D:\MRE\lib\w64devkit\bin\cmake.exe --regenerate-during-build -SD:\MRE\VXPEngine\engine\coremre\tests -BD:\MRE\VXPEngine\tmp\coremre-tests"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

# =============================================================================
# Target aliases.

build vxpe_actor_sprite_regression: phony vxpe_actor_sprite_regression.exe

build vxpe_artstyle_regression: phony vxpe_artstyle_regression.exe

