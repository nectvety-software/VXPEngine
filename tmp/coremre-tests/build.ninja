build all: phony libvxpgdx_test_runtime.a vxpe_story2d_regression.exe vxpe_story2d_c_api.exe vxpe_sprite_fast_regression.exe vxpe_toon3d_regression.exe vxpe_toon3d_c_api.exe vxpe_actor_sprite_regression.exe vxpe_color_grade_regression.exe vxpgdx_vxtm3_regression.exe vxpgdx_ui_arm_regression.exe vxpe_scene25d_regression.exe vxpe_stage2d_regression.exe vxpe_artstyle_regression.exe vxpgdx_strategy_rpg_regression.exe vxpe_dungeonfx_regression.exe vxpe_pixel_font_regression.exe vxpe_scatter_regression.exe vxpe_graphics_benchmark.exe

