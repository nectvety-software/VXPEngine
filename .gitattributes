# Auto detect text files and perform LF normalization
* text=auto

# Vendored agent-sprite-forge tree: store and check out byte-for-byte.
# verification.digest_sha256 in third_party/VENDOR-agent-sprite-forge.json is
# computed over these exact bytes, so eol normalisation must never touch them
# (and the tree is read-only upstream code, so it must not be rewritten).
third_party/agent-sprite-forge/** -text

# Never let the auto-detection above treat image data as text: a `text` rule
# matching a whole directory silently stripped one CR byte out of the PNGs in
# engine/coremre/tests/data/sprite_forge, which is a corrupt asset, not a
# formatting difference.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Golden import fixtures must keep their exact bytes through a clone.
# tools/vxp_import_sprite_forge.py writes LF and the importer test compares the
# re-baked header against the committed one byte for byte. On a Windows clone
# with core.autocrlf=true that gate failed 2 of 15 checks: the golden headers
# came out CRLF, and animation-clips.json came out CRLF too, which changes the
# manifest sha256 the header embeds. Proven by cloning main and running
# test_sprite_forge_importer.py inside the clone.
# Scoped to *.h and *.json on purpose: the sibling *.png frames hold CR bytes
# that a directory-wide `text` rule silently deleted.
engine/coremre/tests/data/sprite_forge/**/*.h text eol=lf
engine/coremre/tests/data/sprite_forge/**/*.json text eol=lf
tools/vxp_import_sprite_forge.py text eol=lf
tools/generate_vampireveil_assets.py text eol=lf
