# Native build-time JSON generation: VXPEPython is an SDK-only tool host.
cmake_minimum_required(VERSION 3.19)
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(READ "${ROOT}/assets/gameplay/${DATA}.json" json)

function(integer out lo hi)
    string(JSON value GET "${json}" ${ARGN})
    string(JSON type TYPE "${json}" ${ARGN})
    if(NOT type STREQUAL "NUMBER" OR NOT value MATCHES "^-?[0-9]+$" OR value LESS lo OR value GREATER hi)
        message(FATAL_ERROR "Invalid integer ${ARGN}: ${value}; expected ${lo}..${hi}")
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(text out limit)
    string(JSON value GET "${json}" ${ARGN})
    string(JSON type TYPE "${json}" ${ARGN})
    string(LENGTH "${value}" length)
    if(NOT type STREQUAL "STRING" OR length LESS 1 OR length GREATER limit OR value MATCHES "[^ -~]")
        message(FATAL_ERROR "Invalid ASCII text ${ARGN}")
    endif()
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    set(${out} "\"${value}\"" PARENT_SCOPE)
endfunction()

if(DATA STREQUAL "heroes")
    string(JSON count LENGTH "${json}" heroes)
    if(NOT count EQUAL 3)
        message(FATAL_ERROR "Keep the three hero archetypes")
    endif()
    set(ids velin torvan nimara)
    set(header "#pragma once\nconst HeroDef duel_heroes[3]={\n")
    foreach(i RANGE 0 2)
        list(GET ids ${i} expected)
        string(JSON id GET "${json}" heroes ${i} id)
        if(NOT id STREQUAL expected)
            message(FATAL_ERROR "Keep the three archetypes in order")
        endif()
        text(name 6 heroes ${i} name)
        text(role 24 heroes ${i} role)
        text(passive 32 heroes ${i} passive)
        set(row "{${name},${role},${passive},{")
        string(JSON count LENGTH "${json}" heroes ${i} skills)
        if(NOT count EQUAL 4)
            message(FATAL_ERROR "Expected four skills")
        endif()
        foreach(s RANGE 0 3)
            text(value 20 heroes ${i} skills ${s})
            if(s GREATER 0)
                string(APPEND row ",")
            endif()
            string(APPEND row "${value}")
        endforeach()
        string(APPEND row "}")
        foreach(spec "max_hp,1,5000" "max_mana,1,2000" "speed,1,4" "attack,1,300" "attack_range,10,180" "attack_cd,100,1000")
            string(REPLACE "," ";" parts "${spec}")
            list(GET parts 0 key)
            list(GET parts 1 lo)
            list(GET parts 2 hi)
            integer(value ${lo} ${hi} heroes ${i} ${key})
            set(${key} ${value})
            string(APPEND row ",${value}")
        endforeach()
        foreach(key cost cd)
            string(JSON count LENGTH "${json}" heroes ${i} ${key})
            if(NOT count EQUAL 4)
                message(FATAL_ERROR "Expected four ${key} values")
            endif()
            if(key STREQUAL "cost")
                set(lo 1)
                set(hi ${max_mana})
            else()
                set(lo 100)
                set(hi 7000)
            endif()
            string(APPEND row ",{")
            foreach(s RANGE 0 3)
                integer(value ${lo} ${hi} heroes ${i} ${key} ${s})
                if(s GREATER 0)
                    string(APPEND row ",")
                endif()
                string(APPEND row "${value}")
            endforeach()
            string(APPEND row "}")
        endforeach()
        integer(color 0 65535 heroes ${i} color)
        string(APPEND header "${row},${color}},\n")
    endforeach()
    string(APPEND header "};\n")
    set(output hero_roster_generated.h)
elseif(DATA STREQUAL "world")
    foreach(key world viewport)
        string(JSON count LENGTH "${json}" ${key})
        if(NOT count EQUAL 2)
            message(FATAL_ERROR "Invalid ${key} dimensions")
        endif()
        integer(width 240 240 ${key} 0)
        if(key STREQUAL "world")
            integer(height 960 960 ${key} 1)
        else()
            integer(height 320 320 ${key} 1)
        endif()
    endforeach()
    string(JSON count LENGTH "${json}" objects)
    if(count LESS 1 OR count GREATER 64)
        message(FATAL_ERROR "Use 1..64 world objects")
    endif()
    math(EXPR last "${count}-1")
    set(header "#pragma once\nstruct DuelMapObject { int kind,x,y,w,h,solid,cx,cy,cw,ch; };\nstatic const DuelMapObject duel_map_objects[]={\n")
    foreach(i RANGE 0 ${last})
        integer(kind 0 5 objects ${i} kind)
        integer(x 0 239 objects ${i} position 0)
        integer(y 0 959 objects ${i} position 1)
        math(EXPR maxw "240-${x}")
        math(EXPR maxh "960-${y}")
        integer(w 1 ${maxw} objects ${i} size 0)
        integer(h 1 ${maxh} objects ${i} size 1)
        foreach(n RANGE 0 3)
            integer(c${n} -960 960 objects ${i} collision ${n})
        endforeach()
        string(JSON solid GET "${json}" objects ${i} solid)
        if(solid)
            math(EXPR right "${c0}+${c2}")
            math(EXPR bottom "${c1}+${c3}")
            if(c0 LESS 0 OR c1 LESS 0 OR c2 LESS 1 OR c3 LESS 1 OR right GREATER w OR bottom GREATER h)
                message(FATAL_ERROR "Invalid collider on object ${i}")
            endif()
            set(solid 1)
        else()
            set(solid 0)
        endif()
        string(APPEND header "{${kind},${x},${y},${w},${h},${solid},${c0},${c1},${c2},${c3}},\n")
    endforeach()
    string(APPEND header "};\nstatic const int duel_map_count=sizeof(duel_map_objects)/sizeof(duel_map_objects[0]);\n")
    set(output world_generated.h)
else()
    message(FATAL_ERROR "Unknown gameplay dataset: ${DATA}")
endif()
file(WRITE "${ROOT}/src/${output}" "${header}")
message(STATUS "Validated and generated ${output}")

